---
/**
 * Renders every page of one book. Pages are printed once, server-side, into a
 * hidden "page store"; the page-flip controller moves them into the visible
 * slots as the reader turns pages.
 */
import type { PageSpec } from "../../lib/books";
import { artwork } from "../../content/artwork";
import Page from "./Page.astro";
import ContentsPage from "../pages/ContentsPage.astro";
import ChapterPage from "../pages/ChapterPage.astro";
import TextPage from "../pages/TextPage.astro";
import ProfilePage from "../pages/ProfilePage.astro";
import SkillsPage from "../pages/SkillsPage.astro";
import InterestsPage from "../pages/InterestsPage.astro";
import DoodlesPage from "../pages/DoodlesPage.astro";
import EndPage from "../pages/EndPage.astro";
import ProjectPage from "../portfolio/ProjectPage.astro";
import ArtworkGallery from "../portfolio/ArtworkGallery.astro";

interface Props {
  pages: PageSpec[];
}

const { pages } = Astro.props;
---

{
  pages.map((page) => (
    <Page index={page.index} kind={page.kind} anchor={page.anchor}>
      {page.kind === "contents" && <ContentsPage book={page.book} entries={page.entries} />}
      {page.kind === "chapter" && <ChapterPage chapter={page.chapter} volume={page.volume} />}
      {page.kind === "project-art" && (
        <ProjectPage variant="art" project={page.project} index={page.projectIndex} total={page.total} />
      )}
      {page.kind === "project-info" && (
        <ProjectPage variant="info" project={page.project} index={page.projectIndex} prev={page.prev} next={page.next} />
      )}
      {page.kind === "profile" && <ProfilePage profile={page.profile} />}
      {page.kind === "text" && (
        <TextPage
          kicker={page.kicker}
          title={page.title}
          paragraphs={page.paragraphs}
          quote={page.quote}
          note={page.note}
          art={page.art}
        />
      )}
      {page.kind === "skills" && <SkillsPage skills={page.skills} />}
      {page.kind === "interests" && <InterestsPage interests={page.interests} />}
      {page.kind === "gallery" && (
        <ArtworkGallery category={page.category} number={artwork.categories.indexOf(page.category) + 1} />
      )}
      {page.kind === "doodles" && <DoodlesPage />}
      {page.kind === "end" && <EndPage book={page.book} />}
    </Page>
  ))
}
