---
/**
 * The printed design of a book's spine on the shelf, sized entirely with
 * container units.
 */
import type { BookConfig, DecorBook } from "../../config/site.config";

interface Props {
  book: Pick<BookConfig, "tone" | "pattern"> & Partial<Pick<BookConfig, "title" | "volume">> | DecorBook;
  class?: string;
}

const { book, class: className } = Astro.props;
---

<span class:list={["spine", `spine--${book.pattern}`, `tone-${book.tone}`, className]} aria-hidden="true">
  <span class="spine__inner">
    <span class="spine__band spine__band--top"></span>
    {book.volume && <span class="spine__volume">{book.volume}</span>}
    <span class="spine__title">{book.title}</span>
    <span class="spine__emblem">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3.5 C12.6 8.5 14 10.6 19.5 12 C14 13.4 12.6 15.5 12 20.5 C11.4 15.5 10 13.4 4.5 12 C10 10.6 11.4 8.5 12 3.5 z"></path>
      </svg>
    </span>
    <span class="spine__band spine__band--bottom"></span>
  </span>
</span>
