---
/**
 * Renders a piece of art inside a paper frame: real image when provided
 * (optimised via astro:assets for imported files, lazy-loaded otherwise),
 * hand-drawn illustration as a fallback.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Art } from "../../content/types";
import Illustration from "./Illustration.astro";
import { siteConfig } from "../../config/site.config";

interface Props {
  art: Art;
  class?: string;
  /** Frame style. */
  frame?: "plain" | "tape" | "polaroid" | "none";
  /** Makes the artwork open in the lightbox when clicked. */
  zoomable?: boolean;
  /** Title used by the lightbox. */
  title?: string;
  /** Responsive sizes hint for optimised images. */
  sizes?: string;
}

const { art, class: className, frame = "plain", title, sizes = "(max-width: 760px) 90vw, 40vw" } = Astro.props;
const zoomable = (Astro.props.zoomable ?? false) && siteConfig.features.lightbox;
const isImported = typeof art.image === "object" && art.image !== null;
const isUrl = typeof art.image === "string" && art.image.length > 0;
const Tag = zoomable ? "button" : "div";
---

<Tag
  class:list={["artwork", `artwork--${frame}`, className, { "artwork--zoomable": zoomable }]}
  type={zoomable ? "button" : undefined}
  data-lightbox={zoomable ? "" : undefined}
  data-title={zoomable ? title ?? art.alt : undefined}
  data-caption={zoomable ? art.caption : undefined}
  aria-label={zoomable ? `View larger: ${title ?? art.alt}` : undefined}
>
  <span class="artwork__surface">
    {
      isImported ? (
        <Image
          src={art.image as ImageMetadata}
          alt={art.alt}
          widths={[480, 800, 1200]}
          sizes={sizes}
          loading="lazy"
          decoding="async"
          class="artwork__img"
          style={art.focus ? `object-position:${art.focus}` : undefined}
        />
      ) : isUrl ? (
        <img src={art.image as string} alt={art.alt} loading="lazy" decoding="async" class="artwork__img" style={art.focus ? `object-position:${art.focus}` : undefined} />
      ) : (
        <Illustration name={art.illustration ?? "sketchface"} label={art.alt} class="artwork__ill" />
      )
    }
  </span>
  {frame === "tape" && <span class="artwork__tape" aria-hidden="true" />}
  {zoomable && <span class="artwork__zoom" aria-hidden="true">+</span>}
</Tag>
