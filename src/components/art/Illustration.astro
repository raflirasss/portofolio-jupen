---
import { illustrations, type IllustrationName } from "./illustrations";

interface Props {
  name: IllustrationName;
  class?: string;
  /** Accessible description. Omit when purely decorative. */
  label?: string;
  /** Apply the hand-drawn wobble filter (default true). */
  sketchy?: boolean;
}

const { name, class: className, label, sketchy = true } = Astro.props;
---

<svg
  class:list={["ill", `ill--${name}`, className]}
  viewBox="0 0 200 200"
  preserveAspectRatio="xMidYMid meet"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  <g
    filter={sketchy ? "url(#sketchy)" : undefined}
    fill="none"
    stroke="currentColor"
    stroke-width="2.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={illustrations[name]}
  />
</svg>
