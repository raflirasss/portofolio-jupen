---
import { icons, type IconName } from "./icons";

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  /** Accessible label. Omit for decorative icons. */
  label?: string;
}

const { name, size = "1.25em", class: className, label } = Astro.props;
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
  set:html={icons[name]}
/>
