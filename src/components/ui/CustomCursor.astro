---
/** Ink-dot cursor with a trailing sketchy ring. Enabled by src/scripts/cursor.ts. */
---

<div class="cursor" data-cursor-root aria-hidden="true">
  <div class="cursor__ring" data-cursor-ring>
    <svg viewBox="0 0 60 60" class="cursor__sketch">
      <path d="M30 4 C46 3 57 15 56 31 C55 47 43 57 28 56 C13 55 3 43 4 28 C5 15 16 5 31 5" />
    </svg>
    <span class="cursor__label" data-cursor-label></span>
  </div>
  <div class="cursor__dot" data-cursor-dot></div>
</div>
