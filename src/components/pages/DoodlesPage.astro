---
/** Filler page so every book ends on a right-hand page — a few margin doodles. */
import Illustration from "../art/Illustration.astro";
---

<div class="doodles">
  <p class="doodles__title">notes &amp; doodles</p>
  <Illustration name="plant" class="doodles__item doodles__item--1" />
  <Illustration name="teacup" class="doodles__item doodles__item--2" />
  <Illustration name="cat" class="doodles__item doodles__item--3" />
  <span class="doodles__star doodles__star--1" aria-hidden="true">✦</span>
  <span class="doodles__star doodles__star--2" aria-hidden="true">✧</span>
  <span class="doodles__star doodles__star--3" aria-hidden="true">✦</span>
  <p class="doodles__note">(this page intentionally left doodled)</p>
</div>
