---
/**
 * Non-interactive props that make the shelf feel lived-in.
 * All hand-drawn inline SVG; each has a small ambient CSS animation.
 */
import { siteConfig } from "../../config/site.config";

type DecoType = "plant" | "candle" | "stack" | "cat" | "frame" | "note" | "stars" | "bookend";

interface Props {
  type: DecoType;
  class?: string;
}

const { type, class: className } = Astro.props;
const { owner } = siteConfig;
---

<div class:list={["deco", `deco--${type}`, className]} aria-hidden="true" data-deco={type}>
  {
    type === "plant" && (
      <svg viewBox="0 0 120 170" class="deco__svg">
        <g style="stroke:var(--color-ink)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <g class="deco__leaves">
            <path class="deco__leaf deco__leaf--1" d="M60 104 q-38 -6 -46 -46 q36 4 46 46 z" style="fill:var(--color-paper)" />
            <path d="M60 104 q-22 -18 -44 -44" fill="none" stroke-width="1.3" />
            <path class="deco__leaf deco__leaf--2" d="M60 104 q30 -20 44 -60 q-38 10 -44 60 z" style="fill:var(--gray-800)" />
            <path class="deco__leaf deco__leaf--3" d="M60 104 q-8 -52 8 -92 q16 42 -8 92 z" fill="url(#hatch)" />
            <path d="M60 104 q6 -48 8 -92" fill="none" stroke-width="1.3" />
            <path class="deco__leaf deco__leaf--4" d="M60 104 q24 -2 44 10 q-28 10 -44 -10 z" style="fill:var(--gray-200)" />
          </g>
          <rect x="30" y="102" width="60" height="11" rx="3" style="fill:var(--color-paper)" />
          <path d="M34 113 h52 l-7 52 h-38 z" style="fill:var(--gray-300)" />
          <path d="M40 132 h40 M42 144 q18 6 36 0" fill="none" stroke-width="1.3" />
        </g>
      </svg>
    )
  }
  {
    type === "candle" && (
      <svg viewBox="0 0 70 150" class="deco__svg">
        <circle class="deco__glow" cx="35" cy="40" r="30" style="fill:var(--accent-soft)" opacity=".55" />
        <g style="stroke:var(--color-ink)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path class="deco__flame" d="M35 22 c8 10 9 19 0 26 c-9 -7 -8 -16 0 -26 z" style="fill:var(--accent)" />
          <path d="M35 48 v8" />
          <path d="M24 56 h22 v62 h-22 z" style="fill:var(--color-paper)" />
          <path d="M24 64 q6 4 6 12 M46 70 q-4 3 -3 10" fill="none" stroke-width="1.3" />
          <path d="M8 118 h54 q-2 12 -27 12 q-25 0 -27 -12 z" style="fill:var(--gray-800)" />
          <path d="M62 122 q12 0 10 10 q-2 6 -10 4" fill="none" />
        </g>
      </svg>
    )
  }
  {
    type === "stack" && (
      <svg viewBox="0 0 150 120" class="deco__svg">
        <g style="stroke:var(--color-ink)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <g class="deco__hourglass">
            <path d="M58 6 h34 M58 52 h34" />
            <path d="M62 6 q0 16 13 23 q-13 7 -13 23 h26 q0 -16 -13 -23 q13 -7 13 -23 z" style="fill:var(--color-paper)" />
            <path d="M66 48 q9 -10 18 0 z" style="fill:var(--gray-600)" />
            <path d="M75 30 v12" stroke-width="1.2" stroke-dasharray="1 3" />
          </g>
          <path d="M14 52 h122 v20 h-122 z" style="fill:var(--gray-700)" />
          <path d="M22 56 v12 M128 56 v12" style="stroke:var(--gray-200)" stroke-width="1.3" />
          <path d="M6 72 h134 v22 h-134 z" style="fill:var(--color-paper)" />
          <path d="M14 78 h40 M14 86 h26" stroke-width="1.3" />
          <path d="M18 94 h118 v22 h-118 z" style="fill:var(--gray-400)" />
          <path d="M100 98 v14 M106 98 v14" stroke-width="1.3" />
        </g>
      </svg>
    )
  }
  {
    type === "cat" && (
      <svg viewBox="0 0 170 110" class="deco__svg">
        <g class="deco__z" fill="none" style="stroke:var(--color-ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path class="deco__z1" d="M128 22 h8 l-8 8 h8" />
          <path class="deco__z2" d="M142 6 h10 l-10 10 h10" />
        </g>
        <g style="stroke:var(--color-ink)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <g class="deco__cat-body">
            <path d="M14 106 q-8 -46 44 -54 q42 -6 74 10 q20 12 18 44 z" style="fill:var(--color-paper)" />
            <path d="M50 66 q12 26 2 40 M76 60 q14 26 4 46 M100 62 q12 24 4 44" fill="none" stroke-width="1.4" />
          </g>
          <path d="M104 72 q0 -26 24 -28 l6 -16 l10 15 q10 1 13 7 l11 -13 l3 20 q4 9 2 19 q-8 22 -38 18 q-31 -4 -31 -22 z" style="fill:var(--color-paper)" />
          <path d="M124 74 q4 3 8 0 M144 72 q4 3 8 0" fill="none" />
          <path d="M136 82 l2 2 l2 -2" fill="none" stroke-width="1.4" />
          <path class="deco__tail" d="M18 104 q-20 2 -16 -18 q3 -10 12 -8 q-4 8 0 14 q4 6 10 4 z" style="fill:var(--gray-700)" />
        </g>
      </svg>
    )
  }
  {
    type === "frame" && (
      <svg viewBox="0 0 150 140" class="deco__svg">
        <g style="stroke:var(--color-ink)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M75 4 L30 40 M75 4 L120 40" fill="none" stroke-width="1.4" />
          <circle cx="75" cy="5" r="3" style="fill:var(--color-ink)" />
          <rect x="18" y="38" width="114" height="94" rx="3" style="fill:var(--color-paper)" />
          <rect x="28" y="48" width="94" height="74" style="fill:var(--gray-50)" stroke-width="1.4" />
          <circle cx="98" cy="66" r="8" style="fill:var(--accent-soft)" stroke-width="1.4" />
          <path d="M28 112 L54 78 L72 100 L86 86 L122 116 V122 H28 z" fill="url(#hatch)" stroke-width="1.6" />
          <path d="M54 78 L72 100 L60 104 z" style="fill:var(--gray-700)" stroke-width="1.4" />
        </g>
      </svg>
    )
  }
  {
    type === "note" && (
      <div class="deco__note">
        <span class="deco__pin" />
        <span class="deco__note-label">now playing</span>
        <span class="deco__note-text">{owner.role.toLowerCase()}</span>
        <span class="deco__note-doodle">♡</span>
      </div>
    )
  }
  {
    type === "stars" && (
      <svg viewBox="0 0 200 160" class="deco__svg">
        <g style="stroke:var(--color-ink)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none">
          <g class="deco__hang deco__hang--1">
            <path d="M30 0 v62" stroke-dasharray="2 4" />
            <path d="M30 60 l5 11 l12 1 l-9 8 l3 12 l-11 -6 l-11 6 l3 -12 l-9 -8 l12 -1 z" style="fill:var(--color-paper)" stroke-width="2" />
          </g>
          <g class="deco__hang deco__hang--2">
            <path d="M90 0 v100" stroke-dasharray="2 4" />
            <path d="M90 100 a12 12 0 1 0 10 18 a9 9 0 1 1 -10 -18 z" style="fill:var(--accent-soft)" stroke-width="2" />
          </g>
          <g class="deco__hang deco__hang--3">
            <path d="M150 0 v44" stroke-dasharray="2 4" />
            <path d="M150 42 l4 8 l9 1 l-7 6 l2 9 l-8 -4 l-8 4 l2 -9 l-7 -6 l9 -1 z" style="fill:var(--gray-800)" stroke-width="2" />
          </g>
        </g>
      </svg>
    )
  }
  {
    type === "bookend" && (
      <svg viewBox="0 0 70 130" class="deco__svg">
        <g style="stroke:var(--color-ink)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 128 V30 q0 -24 24 -24 q22 0 22 22 V128 z" style="fill:var(--gray-800)" />
          <path d="M33 40 l4 9 l10 1 l-7 7 l2 10 l-9 -5 l-9 5 l2 -10 l-7 -7 l10 -1 z" style="fill:var(--accent)" stroke-width="1.6" />
          <path d="M4 128 h62" />
        </g>
      </svg>
    )
  }
</div>
